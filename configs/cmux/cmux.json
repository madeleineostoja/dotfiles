{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "app": {
    "sendAnonymousTelemetry": false,
    "workspaceInheritWorkingDirectory": true,
    "minimalMode": true,
    "hideTabCloseButton": true,
    "appearance": "dark"
  },
  "paneBorderColor": "#494D64",
  "activePaneBorderColor": "#24273A",
  "workspaceColors": {
    "selectionColor": "#363A4F",
    "notificationBadgeColor": "#ED8796"
  },
  "terminal": {
    "autoResumeAgentSessions": true
  },
  "notifications": {
    "showInMenuBar": false
  },
  "automation": {
    "socketControlMode": "cmuxOnly"
  },
  "sidebarAppearance": {
    "matchTerminalBackground": false,
    "darkModeTintColor": "#1E2030",
    "tintOpacity": 1
  },
  "sidebar": {
    "showNotificationMessage": false
  }
}
