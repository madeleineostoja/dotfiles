{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(ls:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"],
    "defaultMode": "auto"
  },
  "model": "opus",
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "theme": "dark",
  "skipAutoPermissionPrompt": true
}
